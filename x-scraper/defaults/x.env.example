# Single-account example
TWITTER_AUTH_TOKEN="replace-with-your-auth-token"
TWITTER_CT0="replace-with-your-ct0-token"
XCSRF_TOKEN="replace-with-your-ct0-token"

# Multi-account example: either use one combined string...
# X_AUTH_CREDENTIALS="auth-token-1:ct0-token-1|auth-token-2:ct0-token-2"

# ...or use numbered pairs and let the loader combine them automatically.
# TWITTER_AUTH_TOKEN_1="replace-with-auth-token-1"
# TWITTER_CT0_1="replace-with-ct0-token-1"
# TWITTER_AUTH_TOKEN_2="replace-with-auth-token-2"
# TWITTER_CT0_2="replace-with-ct0-token-2"
